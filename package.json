{
  "name": "screamer-lang",
  "version": "1.2.0",
  "description": "A domain-specific language for live coding performances using ray marching",
  "main": "index.js",
  "scripts": {
    "grammar": "npx peggy screamer.pegjs -o screamer-lang2.js --format es",
    "build": "browserify ./index.js -p esmify --standalone Screamer > dist/screamer.js"
  },
  "keywords": [
    "live",
    "coding",
    "ray",
    "marching",
    "graphics",
    "performance"
  ],
  "author": "Charlie Roberts",
  "license": "MIT",
  "dependencies": {
    "marching": "^1.1.4"
  },
  "devDependencies": {
    "peggy": "^4.0.2",
    "browserify": "^17.0.0",
    "esmify": "^2.1.1"
  }
}
